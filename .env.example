# CWN Production Environment Variables
# Copy this file to .env and fill in real values
# Never commit .env to git - it contains secrets
#
# TEAM REFERENCE (no secrets): docs/ops/REQUIRED_API_KEYS.md — who needs Anthropic vs Gemini
#
# Both are typically required for the “full” gated pipeline as coded today:
#   ANTHROPIC — Gate 3b and other Claude calls under lib/qa (optional script surgical fix path in script_gen)
#   GEMINI    — Script gen, Gate 0/1 script QA (lib/gates/gate1.js), Gate 1b video review, Gate 3a, Gate 4, …
# If someone only has Anthropic OR only Gemini, parts of the line will fail or /health will show missing.

# AuraFlux API backend (also listed in app/.env.local.example for Next.js)
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_SUPPORT_SMS_NUMBER=

# Anthropic Claude — Gate 3b, optional claudeScriptFix in script_gen (see lib/qa.js)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# OpenAI — YouTube titles, descriptions, tags, TikTok captions (lib/publish.js)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Google Gemini API — script_gen, Gate 1 script QA, gate3a, gate4, video file analysis
GEMINI_API_KEY=your-gemini-api-key-here
# Gate 1 script QA model (default: GEMINI_SCRIPT_MODEL → GEMINI_MODEL → gemini-2.5-flash)
# GEMINI_GATE1_MODEL=gemini-2.5-flash

# Gate 1b (Gemini video review, lib/gates/gate1_video_reviewer.js): set GATE1_VIDEO_REVIEW=0 to skip.
# Cache for downloaded source clips (TTL default 20m; min 60s if overridden):
# GATE1_VIDEO_CACHE_TTL_MS=1200000
# GATE1_VIDEO_CACHE_MAX_FILES=32
# Optional absolute cache directory (default: $TMPDIR/cwn_gate1b_video_cache)
# GATE1_VIDEO_CACHE_DIR=/var/tmp/cwn_gate1b_video_cache
# Drop abandoned download temps (*.mp4.part_*) older than this (default max(1h, 3× cache TTL)):
# GATE1_VIDEO_CACHE_PART_MAX_AGE_MS=7200000

# =============================================================================
# HEYGEN AVATAR SERVICE
# =============================================================================

# HeyGen API key (pay-as-you-go, ~$0.038/segment)
HEYGEN_API_KEY=your-heygen-api-key-here
# Optional: required for POST /admin/heygen/delete-all endpoint auth
# HEYGEN_ADMIN_TOKEN=replace-with-random-long-token

# Avatar IDs for different formats
HEYGEN_AVATAR_ID=19c1d4adf890...your-landscape-avatar-id    # 16:9 long-form
HEYGEN_AVATAR_SHORT_ID=ed57439c9c3d...your-portrait-avatar-id # 9:16 short-form
# Optional short-form per-content overrides (used for c0 short workflows):
# HEYGEN_AVATAR_SHORT_NBA_ID=your-nba-short-avatar-id
# HEYGEN_AVATAR_SHORT_NEWS_ID=your-news-short-avatar-id
# HEYGEN_AVATAR_SHORT_TWITCH_ID=your-twitch-short-avatar-id

# Voice settings
HEYGEN_VOICE_ID=2e598f1a6022448cb6710e5d44665325  # "cw" voice
HEYGEN_SPEAK_SPEED=0.85  # 0.85 for compilations, 0.95 for shorts

# Rendering engine for POST /v3/videos: avatar_v (default, best quality) or avatar_iv.
# avatar_v requires the look to list "avatar_v" in supported_api_engines (all C0 looks do).
# HEYGEN_ENGINE=avatar_v

# Avatar rendering engine selection (CPD-989 adapter layer): which lib/avatar adapter renders
# avatar segments: 'heygen' (default) or 'echomimic' (CPD-991, self-hosted).
# Per-job override via jobSpec/card avatarEngine takes precedence over this.
AVATAR_ENGINE=echomimic

# EchoMimicV3 self-hosted avatar engine (CPD-990/991).
# ECHOMIMIC_ENDPOINT_ID=          # RunPod serverless endpoint id (worker/echomimic image); falls back to RUNPOD_ENDPOINT_ID
# ECHOMIMIC_IMAGE_KEY=            # R2 key of the base portrait (default: spike/cpd881/inputs/bobbyg_studio.png)
# ECHOMIMIC_STEPS=8               # QA winner 2026-06-14 (spike8 + heygen_frame)
# ECHOMIMIC_MAX_FRAMES=81         # single-window cap (81 frames = 3.24s @ 25fps, validated window)
# ECHOMIMIC_SPEAK_SPEED=0.85      # match HeyGen long-form cadence
# ECHOMIMIC_IMAGE_KEY=spike/cpd881/inputs/bobbyg_heygen_frame.png  # HeyGen still → best mouth ref (default)
# ECHOMIMIC_AUDIO_GUIDANCE_SCALE=2.0   # QA winner — lip-sync (try 2.5 for sweep_heygen variant)
# ECHOMIMIC_GUIDANCE_SCALE=4.5         # spike default
# ECHOMIMIC_SKIP_START_STEPS=5         # spike default
# ECHOMIMIC_USE_DYNAMIC_CFG=0          # off for spike profile; set 1 to try dynamic CFG variants
# ECHOMIMIC_USE_DYNAMIC_ACFG=1
# ECHOMIMIC_NEG_SCALE=1.5
# ECHOMIMIC_NEG_STEPS=2
# ECHOMIMIC_AUDIO_SCALE=1.0
# ECHOMIMIC_SEED=43
# ELEVENLABS_API_KEY=             # TTS for echomimic engine (stage 1 of the two-stage render)
# ELEVENLABS_VOICE_ID=            # optional — falls back to ELEVENLABS_DEFAULT_VOICE_ID
# ECHOMIMIC_AUDIO_SOURCE=elevenlabs   # default — cloned Bobby G TTS
# ECHOMIMIC_HEYGEN_AUDIO_FALLBACK=1   # set 0 when HeyGen account closes
# ELEVENLABS_MODEL=eleven_flash_v2_5  # half credit cost; eleven_v3 auto when delivery tags present
# ECHOMIMIC_DATACENTER=EU-RO-1        # primary GPU region (network volume must match)
# ECHOMIMIC_GPU_TYPES=NVIDIA GeForce RTX 4090,NVIDIA L40S,NVIDIA A40,NVIDIA L4  # L4 when 4090 pool full
# ECHOMIMIC_DATACENTER_FALLBACK=US-TX-3,US-KS-2,US-GA-2  # when EU pool exhausted
# ECHOMIMIC_POD_ID=                 # RunPod pod id — proxy https://{id}-8000.proxy.runpod.net
# ECHOMIMIC_POD_AUTO_STOP=on        # stop GPU after avatar batch (off = leave running)
# ECHOMIMIC_POD_POLL_MS=15000       # async /run job poll interval
# ECHOMIMIC_POD_TIMEOUT_MS=1800000  # max wait per segment render
# ECHOMIMIC_SAMPLE_SIZE=768         # 768 on 24GB+ pod; 512 if serverless only

# Delivery enhancement (CPD-606): Gemini inserts ElevenLabs v3 audio tags ([excited], [whispers])
# + <break> pauses into the HeyGen script; voice switches to eleven_v3 engine so tags are performed
# rather than spoken. Replicates the web app "Auto-enhance" delivery style. Default on; 0 disables.
# HEYGEN_ENHANCE_DELIVERY=1

# HeyGen folder_id (legacy v2-only — NOT sent on v3 API; videos go to default library).
# List/create folders: https://docs.heygen.com/reference/list-folders
HEYGEN_FOLDER_ID_NBA_NFL=58fc34001dce47fb8697e1dc9a0c4abb
HEYGEN_FOLDER_ID_NEWS=83e6b8a858354ce7ba5053b6e6565d72
HEYGEN_FOLDER_ID_TWITCH=673a74b8d0e446e78b07e7ebf9bf91b0
# After first HeyGen submit, poll video.list once to confirm folder_id stuck (set 0 to skip).
# HEYGEN_VERIFY_FOLDER=0
HEYGEN_TEMPLATE_LANDSCAPE=      # Pre-baked landscape template ID (reduces render cost)
HEYGEN_TEMPLATE_PORTRAIT=       # Pre-baked portrait template ID (reduces render cost)

# Local / CI: simulate avatar segments with ffmpeg (no HeyGen API spend). See npm run phase-a:batch:sim
# HEYGEN_SIM_MODE=true
# HEYGEN_SIM_DURATION_SEC=6
# HEYGEN_SIM_FONT=/path/to/DejaVuSans.ttf

# QA cycle at each gate (lib/qa_cycle.js + lib/monitoring.js): Tier 1 QA review only (gate:sendback); Tier 2 ops (gate:ops_sendback) does not count
# QA_MAX_WORKER_SENDBACKS=3
# QA_MAX_INTERVENTION_ATTEMPTS=3

# Require QA agents to ack generate (like gate-worker pre-gen sign-off). Monitored via qa:generate_confirm_policy + job_spec.state.automation.qaGenerateConfirm
# QA_CONFIRM_ON_GENERATE=false

# Gate 3a: if true (default), missing chrome/flag/sidebar per Gemini sample → hard_fail (aligns automated pass with creative bar). Set false to allow pass_with_notes only.
# GATE3A_CHROME_STRICT=false  # set false to disable sidebar strict blocker (needed when sidebar uses sliding window with >5 stories)

# Gate 2: minimum avatar segment duration (seconds). Default 2.5 — avoids hard_fail on ~2.8s HeyGen clips; set 3 to restore stricter bar.
# GATE2_MIN_SEGMENT_SECONDS=2.5

# Phase A batch (scripts/phase_a_batch.cjs): defaults are exit only on Gate 5 or PHASE_A_WATCH_MAX_MS — not on "stable 2 min". Override if needed:
# PHASE_A_WATCH_EXIT_ON_STABLE=0
# PHASE_A_WATCH_MAX_MS=7200000

# Al Jazeera news pool (GET /news/us-canada-videos):
# hard-locked to section paths /where/united-states/ and /us-canada/, portrait-only clips.
# Discovery order: primary hub (NEWS_US_PRIMARY_HUB_URL) -> fallback hub (NEWS_US_CANADA_HUB_URL)
# -> matching sitemap paths.
# Optional pinned article URLs tried before the ordered list (set to "off" to disable):
# NEWS_AJ_PINNED_URLS=
# Max clip duration (seconds) after portrait filter — default 180 (set 0 to disable ffprobe cap):
# NEWS_AJ_MAX_CLIP_SEC=180
# Override hubs if needed:
# NEWS_US_PRIMARY_HUB_URL=https://www.aljazeera.com/where/united-states/
# NEWS_US_CANADA_HUB_URL=https://www.aljazeera.com/us-canada/

# =============================================================================
# TWITCH API
# =============================================================================

# Twitch API credentials for clip resolution
TWITCH_CLIENT_ID=your-twitch-client-id-here
TWITCH_TOKEN=your-twitch-token-here  # Also used in OBS Browser Source
# TWITCH_CLIENT_SECRET: optional — secret of the TWITCH_CLIENT_ID app. When set,
# expired app tokens auto-refresh on 401 (CPD-865). Without it the refresh falls
# back to the TWITCH_OAUTH_CLIENT_ID/SECRET pair.
# TWITCH_CLIENT_SECRET=

# =============================================================================
# GOOGLE DRIVE INTEGRATION
# =============================================================================

# Google Drive folder for video backups
DRIVE_FOLDER_ID=your-google-drive-folder-id

# OAuth tokens (run `node cwn-auth.js` to generate)
DRIVE_CLIENT_ID=your-google-drive-client-id
DRIVE_CLIENT_SECRET=your-google-drive-client-secret
DRIVE_REFRESH_TOKEN=your-drive-refresh-token-here

# =============================================================================
# MULTI-PLATFORM PUBLISHING
# =============================================================================

# Upload-Post API (Professional $50/month)
UPLOADPOST_API_KEY=your-uploadpost-jwt-token-here
UPLOADPOST_PROFILE=clipznashite  # Your Upload-Post profile name
UPLOADPOST_STATUS_PATH=/uploadposts/status  # C0 gate5 + portal5 poll endpoint (not /status)
UPLOADPOST_POLL_TIMEOUT_MS=900000  # 15 min for large video uploads
UPLOADPOST_POLL_INTERVAL_MS=10000

# Comma-separated Upload-Post targets (Gate 5). If unset, defaults to youtube in assembly fallbacks.
# Set to none, skip, or 0 to skip Gate 5 entirely (full gates 0–4 E2E without burning YouTube daily upload quota).
# AUTO_PUBLISH_PLATFORMS=youtube
# AUTO_PUBLISH_PLATFORMS=none

# =============================================================================
# DOPPLER (bootstrap only — shared secrets live in Doppler auraflux/prd)
# =============================================================================
# Local .env = localhost-only (pm2, sidecar port, LIVE_GRID_*, CALENDAR_*, etc.).
# Atlassian / shared production creds: bash scripts/doppler_run.sh <cmd>
# See cwn-production .env.example DOPPLER section for full agent pattern.
DOPPLER_TOKEN=dp.st.prd.xxxx

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Topaz Labs (video upscaling - optional)
TOPAZLABS_API_KEY=your-topaz-labs-key-here

# Canva Connect API (thumbnail generation)
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret

# Financial Modeling Prep (market ticker data)
FMP_API_KEY=your-fmp-api-key-here

