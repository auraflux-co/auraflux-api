# AuraFlux API — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to git — it contains secrets.
#
# Keys marked [RENDER-INJECTED] are set automatically by Render when services are linked.
# Keys marked [REQUIRED] must be set manually before the server will start.
# All others are optional or have safe defaults.

# =============================================================================
# AI API KEYS
# =============================================================================

# Anthropic Claude — Portal 3b (Claude script QA), lib/portals/portal3b.js
# [REQUIRED for Portal 3b]
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# Google Gemini — script gen, Portal 1 script QA, Portal 3a, Portal 4, video analysis
# [REQUIRED for core pipeline]
GEMINI_API_KEY=your-gemini-api-key-here

# Portal 1 script QA model override (default: GEMINI_SCRIPT_MODEL → GEMINI_MODEL → gemini-2.5-flash)
# GEMINI_GATE1_MODEL=gemini-2.5-flash

# General-purpose Gemini model (used across Portal 1, Portal 3a, Portal 4)
GEMINI_MODEL=gemini-2.5-flash

# Script generation model (used by Portal 1 and Concierge)
# GEMINI_SCRIPT_MODEL=

# Web research pre-processor model (CPD-76 — lib/research/web_research.js)
# Default: gemini-2.0-flash (fast; uses Google Search grounding)
# RESEARCH_GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# PORTAL PIPELINE SETTINGS (C1+ only)
# =============================================================================

# BullMQ worker concurrency — number of jobs processed in parallel (default: 2)
PIPELINE_WORKER_CONCURRENCY=2
# CPD-325: Cap Node.js heap to leave headroom for ffmpeg child processes (Render Standard = 2GB RAM)
NODE_OPTIONS=--max-old-space-size=1536
# CPD-325: BullMQ memory circuit breaker — pause worker when heap exceeds this threshold
# Default 1200MB (78% of 1536MB cap). Worker resumes when heap drops below WORKER_MEM_RESUME_MB.
WORKER_MEM_PAUSE_MB=1200
WORKER_MEM_RESUME_MB=900

# Portal 1b — Gemini video review (lib/portals/portal1_video_reviewer.js)
# Set PORTAL1_VIDEO_REVIEW=0 to disable video review step. GATE1_VIDEO_REVIEW=0 also accepted.
# PORTAL1_VIDEO_REVIEW=1
# GATE1_VIDEO_REVIEW=1

# Portal 1b video cache settings (downloaded source clips):
# GATE1_VIDEO_CACHE_TTL_MS=1200000        # Cache TTL — default 20 minutes
# GATE1_VIDEO_CACHE_MAX_FILES=32          # Max cached files before eviction
# GATE1_VIDEO_CACHE_DIR=/var/tmp/auraflux_portal1b_cache    # Optional: absolute cache path
# GATE1_VIDEO_CACHE_PART_MAX_AGE_MS=7200000  # Max age for abandoned *.part_ downloads (default 2h)

# Portal 2 — avatar segment assembly (lib/portals/portal2.js)
# GATE2_MIN_SEGMENT_SECONDS=2.5   # Minimum segment duration. Default 2.5s — below this = hard_fail
# GATE2_STUCK_THRESHOLD_MS=       # Max ms portal2 waits before declaring stuck

# Portal 3a — chrome/overlay QA (lib/portals/portal3a.js)
# GATE3A_CHROME_STRICT=true       # true (default) = missing chrome elements → hard_fail

# QA retry policy (lib/gate_policy_runner.js):
# QA_MAX_WORKER_SENDBACKS=3
# QA_MAX_INTERVENTION_ATTEMPTS=3
# QA_CONFIRM_ON_GENERATE=false    # Require portal-worker sign-off before generation

# Portal 5 — publish platforms. Comma-separated Upload-Post targets.
# Set to none, skip, or 0 to skip Portal 5 entirely (useful for E2E testing).
AUTO_PUBLISH_PLATFORMS=youtube
# AUTO_PUBLISH_PLATFORMS=none

# =============================================================================
# HEYGEN AVATAR SERVICE
# =============================================================================

# HeyGen API key (pay-as-you-go, ~$0.038/segment)
HEYGEN_API_KEY=your-heygen-api-key-here

# Avatar IDs for different formats
HEYGEN_AVATAR_ID=19c1d4adf890...your-landscape-avatar-id    # 16:9 long-form
HEYGEN_AVATAR_SHORT_ID=ed57439c9c3d...your-portrait-avatar-id # 9:16 short-form

# Content-type-specific short (portrait) avatar overrides (lib/script_gen.js)
# Falls back to HEYGEN_AVATAR_SHORT_ID when not set.
# HEYGEN_AVATAR_SHORT_NBA_ID=
# HEYGEN_AVATAR_SHORT_NEWS_ID=
# HEYGEN_AVATAR_SHORT_TWITCH_ID=

# Voice settings
HEYGEN_VOICE_ID=2e598f1a6022448cb6710e5d44665325
HEYGEN_SPEAK_SPEED=0.85

# HeyGen folder IDs for video library organisation (optional)
HEYGEN_FOLDER_ID_NBA_NFL=58fc34001dce47fb8697e1dc9a0c4abb
HEYGEN_FOLDER_ID_NEWS=83e6b8a858354ce7ba5053b6e6565d72
HEYGEN_FOLDER_ID_TWITCH=673a74b8d0e446e78b07e7ebf9bf91b0

# Pre-baked templates (reduces render cost — leave blank if unused)
HEYGEN_TEMPLATE_LANDSCAPE=
HEYGEN_TEMPLATE_PORTRAIT=

# Optional: required for POST /admin/heygen/delete-all endpoint auth
# HEYGEN_ADMIN_TOKEN=replace-with-random-long-token

# Simulation mode — replaces HeyGen API calls with ffmpeg-generated placeholders (CI/dev only)
# HEYGEN_SIM_MODE=false
# HEYGEN_SIM_DURATION_SEC=6
# HEYGEN_SIM_FONT=/path/to/DejaVuSans.ttf
# HEYGEN_STUCK_POLLS=
# HEYGEN_VERIFY_FOLDER=

# =============================================================================
# ELEVENLABS TTS (CPD-80)
# =============================================================================
# Used by the tts_ext portal extension — fires after Portal 1 for non-avatar jobs.
# Only consumed when addOns.tts.active === true in the job spec.
# Requires plan tier: dwy+  (feature gate: tts.elevenlabs)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# Default voice ID when job spec doesn't specify one. George (en-US) is the fallback.
ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# =============================================================================
# RUNPOD — WAN Video Generation (CPD-69, CPD-79)
# =============================================================================
# Required for entry:'generate' jobs (sourceType:'wan_gen').
# Requires plan tier: dwy+ (feature gate: video.wan_t2v)
RUNPOD_API_KEY=
RUNPOD_POD_ID=
RUNPOD_ENDPOINT_ID=
# WAN model version on the pod (informational — workflow JSON references the filename directly)
# CPD-79: 2.7 Partner Nodes workflow scaffolded. Flip to 2.7 once pod is validated.
WAN_MODEL_VERSION=2.2
# ComfyUI account API key — required for WAN 2.7 Partner Nodes only (CPD-79).
# Obtain from Comfy.org account → Settings → API Keys.
# NOT the same as RUNPOD_API_KEY. The ComfyUI pod passes this to the Wan 2.7 cloud API.
COMFYUI_API_KEY=

# =============================================================================
# TWITCH API
# =============================================================================
# Twitch API credentials for clip resolution (used by clip sourcing module)
TWITCH_CLIENT_ID=your-twitch-client-id-here
TWITCH_TOKEN=your-twitch-token-here

# ── E2E Test Runner (scripts/run_all_18_twitch.py) ────────────────────────────
# Only required when running the 18-test E2E suite locally or in CI.
# AURAFLUX_E2E_BASE defaults to https://auraflux-api.onrender.com if unset.
AURAFLUX_E2E_BASE=https://auraflux-api.onrender.com
AURAFLUX_E2E_API_KEY_OPERATE=your-operate-tier-api-key-here
AURAFLUX_E2E_API_KEY_GUIDED=your-guided-tier-api-key-here
AURAFLUX_E2E_API_KEY_MANAGED=your-managed-tier-api-key-here
# Clerk user IDs for dashboard-auth E2E tests (guided + managed tiers)
# Use an account that has the target plan + all roles assigned
AURAFLUX_E2E_CLERK_USER_GUIDED=user_xxxxxxxxxxxxxxxxxxxxxxxx
AURAFLUX_E2E_CLERK_USER_MANAGED=user_xxxxxxxxxxxxxxxxxxxxxxxx
E2E_AUTH_SECRET=your-e2e-auth-secret-here

# =============================================================================
# GOOGLE DRIVE INTEGRATION
# =============================================================================
# Google Drive folder for video output backups
DRIVE_FOLDER_ID=your-google-drive-folder-id

# OAuth tokens (run `node cwn-auth.js` to generate)
DRIVE_CLIENT_ID=your-google-drive-client-id
DRIVE_CLIENT_SECRET=your-google-drive-client-secret
DRIVE_REFRESH_TOKEN=your-drive-refresh-token-here

# Skip Drive upload (useful in local dev to avoid accidental uploads)
SKIP_DRIVE_UPLOAD=false

# =============================================================================
# MULTI-PLATFORM PUBLISHING
# =============================================================================

# Upload-Post API (Professional $50/month) — used by Portal 5
UPLOADPOST_API_KEY=your-uploadpost-jwt-token-here
UPLOADPOST_PROFILE=auraflux

# Direct platform API tokens (CPD-86 — blocked until LLC formation)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
# TIKTOK_ACCESS_TOKEN=

# Frontend app URL — used by lib/routes/social_connect.js to build OAuth redirect URLs
# after social platform auth (YouTube, TikTok, Instagram connect flows).
# Must match the deployed Next.js app URL (e.g. https://app.auraflux.co).
# NEXT_PUBLIC_APP_URL=https://app.auraflux.co

# API URL — used by lib/routes/support.js to construct the Twilio SMS webhook URL.
# Set to the public API base URL (e.g. https://api.auraflux.co).
# Defaults to https://auraflux-api.onrender.com if not set.
NEXT_PUBLIC_API_URL=https://auraflux-api.onrender.com

# =============================================================================
# CLOUDFLARE R2 — VIDEO & BACKUP STORAGE (CPD-50)
# =============================================================================
# Required for nightly automated backups and video output storage.
# Set up at dash.cloudflare.com → R2.

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket names (create in Cloudflare R2 dashboard, access: private)
R2_BACKUP_BUCKET=auraflux-backups
R2_VIDEO_BUCKET=auraflux-video-output

# Public CDN domain for serving R2 assets (e.g. your R2 custom domain or workers.dev URL)
R2_ASSETS_DOMAIN=assets.auraflux.co

# =============================================================================
# POSTGRESQL (CPD-51)
# =============================================================================
# [RENDER-INJECTED] Set automatically when auraflux-pg is linked to auraflux-api.
# For local dev: use the Render "External Database URL" from the auraflux-pg dashboard.
DATABASE_URL=postgresql://auraflux:<password>@<host>/<db>?sslmode=require
# Optional: path to Render CA cert for full TLS chain validation (download from Render Postgres dashboard)
# PGSSLROOTCERT=/app/certs/render-ca.crt

# =============================================================================
# REDIS — BullMQ + Caching
# =============================================================================
# [RENDER-INJECTED] Set automatically when Redis add-on is linked.
REDIS_URL=redis://localhost:6379

# =============================================================================
# STRIPE BILLING (CPD-45, CPD-88)
# =============================================================================
# https://dashboard.stripe.com → API Keys + Webhooks
# Test mode: sk_test_... / whsec_... from `stripe listen --forward-to localhost:3000/credits/webhook`
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret

# Stripe Price IDs for subscription tiers — maps subscription.updated events to plan tier.
# Get from Stripe Dashboard → Products → Pricing.
STRIPE_PRICE_OPERATE=price_1TWJGBE9TNc7qjJs2cEstvYL
STRIPE_PRICE_GUIDED=price_1TWJGME9TNc7qjJsslxfUfRt
STRIPE_PRICE_MANAGED=price_1TWJGNE9TNc7qjJsbImVRk95
# Stripe publishable key — safe for frontend (Next.js app env var)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
# Credit pack price IDs — add after creating one-time products in Stripe dashboard
# Product metadata must include: pack_id = <key below> (e.g. pack_id=credit_topup)
# Leave blank to hide that pack from the billing page
STRIPE_PACK_PRICE_CREDIT_TOPUP=price_1TapjME9TNc7qjJs4Z09qTbe
STRIPE_PACK_PRICE_NARRATION=
STRIPE_PACK_PRICE_TEXT_TO_VIDEO=
STRIPE_PACK_PRICE_AVATAR=
STRIPE_PACK_PRICE_SHOPPABLE=

# =============================================================================
# CLERK AUTH (CPD-21)
# =============================================================================
# https://dashboard.clerk.com → API Keys
# CLERK_SECRET_KEY is server-side only; CLERK_PUBLISHABLE_KEY is required by BOTH the Express API
# (for @clerk/express clerkMiddleware) and the Next.js frontend.
# Roles stored in Clerk public metadata: { role: 'customer' | 'operator' | 'admin' }
CLERK_SECRET_KEY=sk_live_your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=pk_live_your-clerk-publishable-key
# Next.js frontend — must match CLERK_PUBLISHABLE_KEY; required in app/.env.local and Render auraflux-app env
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your-clerk-publishable-key
# Webhook secret from Clerk Dashboard → Webhooks — required to validate inbound Clerk webhook signatures
CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-secret

# Shared secret between Express API and Next.js frontend (must match app/.env.local)
AURAFLUX_API_SECRET=your-strong-random-secret-for-frontend-api

# =============================================================================
# ATLASSIAN (JIRA / CONFLUENCE) — local dev and aider_session_review.sh
# =============================================================================
# Host only is OK — scripts/aider_session_review.sh prepends https://
ATLASSIAN_DOMAIN=aurafluxco.atlassian.net
ATLASSIAN_EMAIL=your-atlassian-email@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token-here
JIRA_PROJECT_KEY=CPD
# Confluence space for product HOW docs (session review recent-pages fetch). Strategy docs may live under CP.
CONFLUENCE_SPACE_KEY=CP
JIRA_BASE_URL=https://your-workspace.atlassian.net
JIRA_USER_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================
GITHUB_TOKEN=ghp_...                    # Fine-grained PAT: pull-requests:write + issues:write
GITHUB_REPO=robertgregory/cwn-production  # Repository slug used by /api/github-sync

# =============================================================================
# NEW RELIC APM
# =============================================================================
NEW_RELIC_LICENSE_KEY=your-40-char-license-key
NEW_RELIC_APP_NAME=AuraFlux
# NR alert setup (do once in New Relic UI):
#   Alerts → Create alert condition → NRQL
#   Query:     SELECT count(*) FROM Log WHERE message LIKE '%"status":"failure"%' AND message LIKE '%AuraFluxBackup%'
#   Window:    1 hour (set in the condition UI — not in the query)
#   Threshold: count > 0 → Critical → notify via email / PagerDuty
NR_PIPELINE_SERVICE=AuraFlux-Pipeline
# POST /internal/alert webhook auth secret — set in Render + NR notification channel header
# NR_ALERT_SECRET=your-random-secret-here
NEW_RELIC_USER_KEY=NRAK-your-user-api-key-here

# =============================================================================
# RENDER API (admin dashboard system-health + RunPod auto-start)
# =============================================================================
# Render API key — used by /admin/system-health to fetch service status/deploy info
# and by lib/ai/runpod.js to start/stop the WAN pod.
# Generate at: https://dashboard.render.com → Account Settings → API Keys
RENDER_API_KEY=rnd_your-render-api-key-here
# Service ID of the auraflux-api Render web service (from the Render dashboard URL)
RENDER_SERVICE_ID=srv-your-render-service-id-here
# Service ID of the auraflux-app Render web service (Next.js frontend)
RENDER_APP_SERVICE_ID=srv-your-render-app-service-id-here

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Topaz Labs — video upscaling (optional, not in active use)
TOPAZLABS_API_KEY=your-topaz-labs-key-here

# Canva Connect API — thumbnail generation (optional)
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_API_KEY=
CANVA_ACCESS_TOKEN=

# Financial Modeling Prep — market ticker data (optional)
FMP_API_KEY=your-fmp-api-key-here
FINNHUB_API_KEY=

# =============================================================================
# VIDEO PROCESSING
# =============================================================================

# VectCut API (Python video editing service — required for thumbnail.vectcut feature gate)
VECTCUT_API_URL=http://localhost:9001

# CapCut (C0 legacy) — local video editing service URL (lib/routes/c0_capcut.js)
# C0 localhost only. Do NOT set in Render.
# CAPCUT_URL=http://localhost:9001

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Server ports
PORT=3000
DASHBOARD_PORT=8765

# Upload directory — where Multer stores customer file uploads (lib/routes/upload.js)
# Defaults to /app/data/uploads in production, data/uploads locally.
# Must be a writable path. In Render, use a Disk mount at /app/data.
# UPLOAD_DIR=/app/data/uploads

# Custom FFmpeg/Chrome paths (auto-detected if not set)
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe
# yt-dlp binary path — defaults to 'yt-dlp' (expects it on PATH); override for Docker/Render where installed elsewhere
# YTDLP_PATH=/usr/local/bin/yt-dlp
# Residential proxy for yt-dlp and Kick (BrightData or similar) — format: http://user:pass@host:port
YTDLP_PROXY=
# Base64-encoded YouTube cookies file for authenticated yt-dlp requests (yt-dlp --cookies flag)
YOUTUBE_COOKIES_BASE64=
# YouTube Data API v3 key — used for channel/video metadata lookups (not OAuth)
# Get from: Google Cloud Console → APIs & Services → Credentials
YOUTUBE_API_KEY=
# Server-side YouTube API key with NO HTTP referer restriction (IP-restricted or unrestricted).
# If absent, falls back to YOUTUBE_API_KEY with a spoofed Referer header (AURAFLUX_APP_URL).
# YOUTUBE_API_KEY is typically browser-restricted and returns 403 from server-side Node.js calls.
YOUTUBE_SERVER_API_KEY=
# Public-facing app URL — used as Referer header fallback for browser-restricted API keys
AURAFLUX_APP_URL=https://auraflux.co
# Kick API base URL override (defaults to https://api.kick.com)
KICK_API_BASE_URL=https://api.kick.com
CHROME_PATH=/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome
PUPPETEER_EXECUTABLE_PATH=

# CORS origins (comma-separated, optional — defaults to same-origin)
ALLOWED_ORIGINS=https://app.auraflux.co,https://auraflux.co,https://auraflux-app.onrender.com,http://localhost:3000,http://localhost:8765

# Admin token for internal service endpoints (POST /credits/consume, etc.)
ADMIN_SECRET=your-admin-secret

# Feature switches
GATE_TEST_MODE=false          # true = skip HeyGen API calls (save credits in testing)
USE_DIRECTIVE_CHROME=true
USE_LOCAL_FFMPEG=false
AI_MEMORY_TRACE_ENABLED=false
SCAFFOLD_PERSISTENCE_STRICT=false

# Brand colors (used by overlay rendering)
BRAND_NAVY=#22304b
BRAND_GOLD=#c7af4f

# Logo size/opacity for different formats
LONG_FORM_LOGO_SIZE=120
LONG_FORM_LOGO_OPACITY=0.85
SHORT_FORM_LOGO_SIZE=80
SHORT_FORM_AUDIO_MIX=both

# =============================================================================
# JOB TIMELINE (logs/job_run_timeline.jsonl)
# =============================================================================
JOB_TIMELINE_MAX_BYTES=52428800   # Rotate when file exceeds this (default 50MB)
JOB_TIMELINE_STRING_MAX=4000
JOB_TIMELINE_ARRAY_MAX=16

# =============================================================================
# DEVELOPMENT / DEBUG
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# Job monitor (used by scripts/job_monitor.js — local dev tool)
# JOB_MONITOR_HEARTBEAT_MS=
# JOB_MONITOR_INTERVAL_MS=
# JOB_MONITOR_LOG=
# JOB_MONITOR_MAX_AGE_MS=
# JOB_MONITOR_MAX_ROWS=
# JOB_MONITOR_STUCK_MS=

# Al Jazeera news pool source settings
# NEWS_AJ_PINNED_URLS=           # Optional pinned article URLs (set to "off" to disable)
# NEWS_AJ_MAX_CLIP_SEC=180       # Max clip duration after portrait filter (0 = no cap)
# NEWS_US_PRIMARY_HUB_URL=https://www.aljazeera.com/where/united-states/
# NEWS_US_CANADA_HUB_URL=https://www.aljazeera.com/us-canada/
# NEWS_RSS_URL=

# Smoke testing (scripts/smoke_test.js / test/smoke_render.test.js / scripts/smoke_test_render.js)
# SMOKE_API=http://localhost:3000
# SMOKE_BASE_URL=http://localhost:8765
# SMOKE_SECOND_PATH=/
# SMOKE_API_URL=https://api.auraflux.co        # CPD-12: target for Render smoke tests
# SMOKE_API_KEY=                                # CPD-12: optional bearer key for Render smoke
# SMOKE_API_SECRET=                             # Auth secret for scripts/smoke_test_render.js

# =============================================================================
# DIRECT PLATFORM PUBLISHING (CPD-86 — YouTube, TikTok, Instagram)
# =============================================================================
TOKEN_ENCRYPTION_KEY=          # 64-char hex (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KICK_CLIENT_ID=                  # Kick Developer App — OAuth 2.1 client ID (CPD-353)
KICK_CLIENT_SECRET=              # Kick Developer App — OAuth 2.1 client secret (CPD-353)
YOUTUBE_CLIENT_ID=               # Google Cloud Console OAuth 2.0 client ID (project: My First Project, client: YouTube-AF)
YOUTUBE_CLIENT_SECRET=           # Google Cloud Console OAuth 2.0 client secret (same client)
# TIKTOK_CLIENT_KEY=             # TikTok for Developers — app client key
# TIKTOK_CLIENT_SECRET=          # TikTok for Developers — app client secret
# META_APP_ID=                   # Meta Developer app ID (Instagram Business Login)
# META_APP_SECRET=               # Meta Developer app secret
API_BASE_URL=https://api.auraflux.co

# 18-test E2E suite (scripts/run_all_18.sh, operate/guided/managed drivers)
# AURAFLUX_E2E_BASE=https://auraflux-api.onrender.com   # API base for all tiers
# AURAFLUX_APP_BASE=https://app.auraflux.co             # Frontend base for browser tests
# AURAFLUX_E2E_API_KEY_OPERATE=                         # API key for the Operate demo account
# AURAFLUX_E2E_API_KEY_GUIDED=                          # API key for the Guided demo account
# AURAFLUX_E2E_API_KEY_MANAGED=                         # API key for the Managed demo account
# AURAFLUX_E2E_USER_ID_GUIDED=user_3DHrNlngvQKhKeOcFr52o3JT1jE   # Clerk user ID for Guided demo
# AURAFLUX_E2E_USER_ID_MANAGED=user_3DIyT3RsdxBA4rPvIKSjb9PRNgu  # Clerk user ID for Managed demo

# Load testing (scripts/load_test_autocannon.js)
# LOAD_TEST_URL=http://localhost:3000/health
# LOAD_TEST_CONNECTIONS=10
# LOAD_TEST_DURATION_SEC=30

# Misc limits
# AUTOMATION_SELF_HEAL_MAX=
# SHORT_CLIP_WINDOW_MAX_SEC=
# SYNTH_ASSEMBLE_API_URL=http://localhost:3000

# =============================================================================
# SMS provider selector — 'telnyx' (default/active) or 'twilio' (rollback)
SMS_PROVIDER=telnyx

# TELNYX — Support SMS (primary, CPD-115)
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_PUBLIC_KEY=your-telnyx-ed25519-public-key-here
TELNYX_NUMBER=+15716002835

# TWILIO — legacy (kept for rollback; set SMS_PROVIDER=twilio to re-enable)
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_NUMBER=+15715001787

# Support SMS number — used for outbound operator replies to customers (not shown in UI)
SUPPORT_SMS_NUMBER=+1XXXXXXXXXX
NEXT_PUBLIC_SUPPORT_SMS_NUMBER=+1XXXXXXXXXX

# Operator inbox (CPD-310): comma-separated Clerk user IDs for accounts that should
# receive operator notifications (new inbound SMS, escalations).
# e.g. OPERATOR_USER_IDS=user_abc123,user_def456
# If not set, falls back to DB query for users with role=operator in api_keys table.
OPERATOR_USER_IDS=

# SMTP for email escalation (last resort — DWY/DFY only)
# Uses Gmail app password or SendGrid SMTP relay
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password-here
# When SMTP is configured in production, set to "true" so the team invite UI hides the manual-link hint.
NEXT_PUBLIC_SMTP_CONFIGURED=

# =============================================================================
# C0 / LOCALHOST-ONLY VARS (do NOT set these in Render — localhost dev only)
# =============================================================================
# These vars are used by legacy C0 code (lib/db.js SQLite, lib/chrome_overlay.js).
# They are NOT referenced by the C1+ Render pipeline.
# CWN_DB_PATH=                   # SQLite path — C0 local DB only
# CWN_OVERLAY_BASELINE_PRESET=   # Overlay baseline preset — C0 only
# FORCE_SIDEBAR_VISIBLE=false    # C0 overlay dev flag
# LEGACY_OVERLAY_ONLY=           # C0 legacy flag
# C0_LEGACY_OVERLAY_ONLY=        # C0-specific alias for LEGACY_OVERLAY_ONLY (lib/assembly.js)
# C0_FORCE_SIDEBAR_VISIBLE=      # C0-specific alias for FORCE_SIDEBAR_VISIBLE (lib/assembly.js)

# =============================================================================
# COMPOSIO — v0 MCP integration (CPD-204)
# =============================================================================
# API key from https://composio.dev — used for v0 UI generation via Claude Code
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# Apify — Kick browsing via cloud scraping (CPD-316)
APIFY_API_TOKEN=
APIFY_USER_ID=

# =============================================================================
# RENDER DEPLOYMENT — internal automation (do NOT expose to frontend)
# =============================================================================
RENDER_API_SERVICE_ID=srv-your-service-id-here

# =============================================================================
# JOB PROCESSING TUNING — optional overrides for portal + assembly behaviour
# =============================================================================
# Maximum minutes to wait for a job to complete before marking it timed out
MAX_POLL_MINUTES=15
# Interval between job status poll attempts in milliseconds
POLL_INTERVAL_MS=5000
# Local dev only — path to a flat JSON file used to persist jobs without Postgres
# JOBS_FILE=/tmp/auraflux_jobs.json

# =============================================================================
# VIDEO ENCODING — GPU acceleration (Render starter plan does not have GPU)
# =============================================================================
# Set to "true" to enable NVENC hardware encoding if a GPU is available
ENABLE_NVENC=false

# =============================================================================
# WAN 2.7 VIDEO GENERATION — C0/C1+ shared service URL
# =============================================================================
# Internal URL of the WAN 2.7 generation service (set in Render private network)
CWN_SERVER_URL=http://your-wan-server:3000

# =============================================================================
# C0 MANUAL WORKFLOW FLAGS — lib/manual_segment_workflow.js
# These override default automation behaviour for specific C0 operator steps.
# All default to their safe/enabled value when unset.
# =============================================================================
# Enable per-segment checkpointing (default: true — leave unset to keep enabled)
C0_MANUAL_SEGMENT_CHECKPOINT=true
# Wait for HeyGen avatar render to complete before proceeding (default: true)
C0_MANUAL_WAIT_FOR_HEYGEN=true
# Pre-fetch source clips into the working folder automatically (default: true)
# Set to "0" or "false" to skip auto-fetch and supply clips manually
C0_MANUAL_PREFETCH_SOURCE_CLIPS=true
# Allow nested HeyGen renders within a segment (default: true)
# Set to "0" or "false" to disable nested avatar renders
C0_MANUAL_HEYGEN_NESTED=true

# =============================================================================
# CLOUDFLARE — Marketing site (auraflux.co) deployment
# =============================================================================
# API token with Cloudflare Pages:Edit permission
# Create at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=cfat_your_pages_edit_token_here
CF_ACCOUNT_ID=df04bc264530390035c77664f1b403d9
CF_PAGES_PROJECT=auraflux-marketing

# =============================================================================
# FRAMER — Marketing site publishing
# =============================================================================
# API key from https://framer.com/developers
FRAMER_API_KEY=fr_your_framer_api_key_here


# OPENAI — GPT-4o quality review + Whisper transcription (CPD-431)
# =============================================================================
# Enables portal_gpt4o_qa extension: deep creative QA on every assembled video.
# Priced into job credits. Without this key the extension self-skips (graceful degradation).
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
