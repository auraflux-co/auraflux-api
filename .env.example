# CWN Production Environment Variables
# Copy this file to .env and fill in real values
# Never commit .env to git - it contains secrets
#
# TEAM REFERENCE (no secrets): docs/ops/REQUIRED_API_KEYS.md — who needs Anthropic vs Gemini
#
# Both are typically required for the “full” gated pipeline as coded today:
#   ANTHROPIC — Gate 3b and other Claude calls under lib/qa (optional script surgical fix path in script_gen)
#   GEMINI    — Script gen, Gate 0/1 script QA (lib/gates/gate1.js), Gate 1b video review, Gate 3a, Gate 4, …
# If someone only has Anthropic OR only Gemini, parts of the line will fail or /health will show missing.

# =============================================================================
# AI API KEYS
# =============================================================================

# Anthropic Claude — Gate 3b, optional claudeScriptFix in script_gen (see lib/qa.js)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# OpenAI — YouTube titles, descriptions, tags, TikTok captions (lib/publish.js)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Google Gemini API — script_gen, Gate 1 script QA, gate3a, gate4, video file analysis
GEMINI_API_KEY=your-gemini-api-key-here
# Gate 1 script QA model (default: GEMINI_SCRIPT_MODEL → GEMINI_MODEL → gemini-2.5-flash)
# GEMINI_GATE1_MODEL=gemini-2.5-flash

# Gate 1b (Gemini video review, lib/gates/gate1_video_reviewer.js): set GATE1_VIDEO_REVIEW=0 to skip.
# Cache for downloaded source clips (TTL default 20m; min 60s if overridden):
# GATE1_VIDEO_CACHE_TTL_MS=1200000
# GATE1_VIDEO_CACHE_MAX_FILES=32
# Optional absolute cache directory (default: $TMPDIR/cwn_gate1b_video_cache)
# GATE1_VIDEO_CACHE_DIR=/var/tmp/cwn_gate1b_video_cache
# Drop abandoned download temps (*.mp4.part_*) older than this (default max(1h, 3× cache TTL)):
# GATE1_VIDEO_CACHE_PART_MAX_AGE_MS=7200000

# =============================================================================
# HEYGEN AVATAR SERVICE
# =============================================================================

# HeyGen API key (pay-as-you-go, ~$0.038/segment)
HEYGEN_API_KEY=your-heygen-api-key-here
# Optional: required for POST /admin/heygen/delete-all endpoint auth
# HEYGEN_ADMIN_TOKEN=replace-with-random-long-token

# Avatar IDs for different formats
HEYGEN_AVATAR_ID=19c1d4adf890...your-landscape-avatar-id    # 16:9 long-form
HEYGEN_AVATAR_SHORT_ID=ed57439c9c3d...your-portrait-avatar-id # 9:16 short-form
# Optional short-form per-content overrides (used for c0 short workflows):
# HEYGEN_AVATAR_SHORT_NBA_ID=your-nba-short-avatar-id
# HEYGEN_AVATAR_SHORT_NEWS_ID=your-news-short-avatar-id
# HEYGEN_AVATAR_SHORT_TWITCH_ID=your-twitch-short-avatar-id

# Voice settings
HEYGEN_VOICE_ID=2e598f1a6022448cb6710e5d44665325  # "cw" voice
HEYGEN_SPEAK_SPEED=0.85  # 0.85 for compilations, 0.95 for shorts

# Rendering engine for POST /v3/videos: avatar_v (default, best quality) or avatar_iv.
# avatar_v requires the look to list "avatar_v" in supported_api_engines (all C0 looks do).
# HEYGEN_ENGINE=avatar_v

# Avatar rendering engine selection (CPD-989 adapter layer): which lib/avatar adapter renders
# avatar segments: 'heygen' (default) or 'echomimic' (CPD-991, self-hosted).
# Per-job override via jobSpec/card avatarEngine takes precedence over this.
AVATAR_ENGINE=echomimic

# EchoMimicV3 self-hosted avatar engine (CPD-990/991).
# ECHOMIMIC_ENDPOINT_ID=          # RunPod serverless endpoint id (worker/echomimic image); falls back to RUNPOD_ENDPOINT_ID
# ECHOMIMIC_IMAGE_KEY=            # R2 key of the base portrait (default: spike/cpd881/inputs/bobbyg_studio.png)
# ECHOMIMIC_STEPS=8               # inference steps; quality tuning raises to 15-25
# ECHOMIMIC_MAX_FRAMES=81         # single-window cap (81 frames = 3.24s @ 25fps, validated window)
# ECHOMIMIC_SPEAK_SPEED=1.0       # ElevenLabs voice speed
# ELEVENLABS_API_KEY=             # TTS for echomimic engine (stage 1 of the two-stage render)
# ELEVENLABS_VOICE_ID=            # Bobby G voice id
# ELEVENLABS_MODEL=eleven_flash_v2_5  # half credit cost; eleven_v3 auto when delivery tags present
# ECHOMIMIC_RENDER_MODE=pod          # pod (4090 dedicated) | serverless (OOM in EU-RO-1 on 20GB)
# ECHOMIMIC_POD_ID=                 # RunPod pod id — proxy https://{id}-8000.proxy.runpod.net
# ECHOMIMIC_POD_AUTO_STOP=on        # stop GPU after avatar batch (off = leave running)
# ECHOMIMIC_POD_POLL_MS=15000       # async /run job poll interval
# ECHOMIMIC_POD_TIMEOUT_MS=1800000  # max wait per segment render
# ECHOMIMIC_SAMPLE_SIZE=768         # 768 on 24GB+ pod; 512 if serverless only

# Delivery enhancement (CPD-606): Gemini inserts ElevenLabs v3 audio tags ([excited], [whispers])
# + <break> pauses into the HeyGen script; voice switches to eleven_v3 engine so tags are performed
# rather than spoken. Replicates the web app "Auto-enhance" delivery style. Default on; 0 disables.
# HEYGEN_ENHANCE_DELIVERY=1

# HeyGen folder_id (legacy v2-only — NOT sent on v3 API; videos go to default library).
# List/create folders: https://docs.heygen.com/reference/list-folders
HEYGEN_FOLDER_ID_NBA_NFL=58fc34001dce47fb8697e1dc9a0c4abb
HEYGEN_FOLDER_ID_NEWS=83e6b8a858354ce7ba5053b6e6565d72
HEYGEN_FOLDER_ID_TWITCH=673a74b8d0e446e78b07e7ebf9bf91b0
# After first HeyGen submit, poll video.list once to confirm folder_id stuck (set 0 to skip).
# HEYGEN_VERIFY_FOLDER=0
HEYGEN_TEMPLATE_LANDSCAPE=      # Pre-baked landscape template ID (reduces render cost)
HEYGEN_TEMPLATE_PORTRAIT=       # Pre-baked portrait template ID (reduces render cost)

# Local / CI: simulate avatar segments with ffmpeg (no HeyGen API spend). See npm run phase-a:batch:sim
# HEYGEN_SIM_MODE=true
# HEYGEN_SIM_DURATION_SEC=6
# HEYGEN_SIM_FONT=/path/to/DejaVuSans.ttf

# QA cycle at each gate (lib/qa_cycle.js + lib/monitoring.js): Tier 1 QA review only (gate:sendback); Tier 2 ops (gate:ops_sendback) does not count
# QA_MAX_WORKER_SENDBACKS=3
# QA_MAX_INTERVENTION_ATTEMPTS=3

# Require QA agents to ack generate (like gate-worker pre-gen sign-off). Monitored via qa:generate_confirm_policy + job_spec.state.automation.qaGenerateConfirm
# QA_CONFIRM_ON_GENERATE=false

# Gate 3a: if true (default), missing chrome/flag/sidebar per Gemini sample → hard_fail (aligns automated pass with creative bar). Set false to allow pass_with_notes only.
# GATE3A_CHROME_STRICT=false  # set false to disable sidebar strict blocker (needed when sidebar uses sliding window with >5 stories)

# Gate 2: minimum avatar segment duration (seconds). Default 2.5 — avoids hard_fail on ~2.8s HeyGen clips; set 3 to restore stricter bar.
# GATE2_MIN_SEGMENT_SECONDS=2.5

# Phase A batch (scripts/phase_a_batch.cjs): defaults are exit only on Gate 5 or PHASE_A_WATCH_MAX_MS — not on "stable 2 min". Override if needed:
# PHASE_A_WATCH_EXIT_ON_STABLE=0
# PHASE_A_WATCH_MAX_MS=7200000

# Al Jazeera news pool (GET /news/us-canada-videos):
# hard-locked to section paths /where/united-states/ and /us-canada/, portrait-only clips.
# Discovery order: primary hub (NEWS_US_PRIMARY_HUB_URL) -> fallback hub (NEWS_US_CANADA_HUB_URL)
# -> matching sitemap paths.
# Optional pinned article URLs tried before the ordered list (set to "off" to disable):
# NEWS_AJ_PINNED_URLS=
# Max clip duration (seconds) after portrait filter — default 180 (set 0 to disable ffprobe cap):
# NEWS_AJ_MAX_CLIP_SEC=180
# Override hubs if needed:
# NEWS_US_PRIMARY_HUB_URL=https://www.aljazeera.com/where/united-states/
# NEWS_US_CANADA_HUB_URL=https://www.aljazeera.com/us-canada/

# =============================================================================
# TWITCH API
# =============================================================================

# Twitch API credentials for clip resolution
TWITCH_CLIENT_ID=your-twitch-client-id-here
TWITCH_TOKEN=your-twitch-token-here  # Also used in OBS Browser Source
# TWITCH_CLIENT_SECRET: optional — secret of the TWITCH_CLIENT_ID app. When set,
# expired app tokens auto-refresh on 401 (CPD-865). Without it the refresh falls
# back to the TWITCH_OAUTH_CLIENT_ID/SECRET pair.
# TWITCH_CLIENT_SECRET=

# =============================================================================
# GOOGLE DRIVE INTEGRATION
# =============================================================================

# Google Drive folder for video backups
DRIVE_FOLDER_ID=your-google-drive-folder-id

# OAuth tokens (run `node cwn-auth.js` to generate)
DRIVE_CLIENT_ID=your-google-drive-client-id
DRIVE_CLIENT_SECRET=your-google-drive-client-secret
DRIVE_REFRESH_TOKEN=your-drive-refresh-token-here

# =============================================================================
# MULTI-PLATFORM PUBLISHING
# =============================================================================

# Upload-Post API (Professional $50/month)
UPLOADPOST_API_KEY=your-uploadpost-jwt-token-here
UPLOADPOST_PROFILE=clipznashite  # Your Upload-Post profile name
UPLOADPOST_STATUS_PATH=/uploadposts/status  # poll endpoint (not /status — CPD-1026)
UPLOADPOST_POLL_TIMEOUT_MS=900000  # 15 min for large video uploads
UPLOADPOST_POLL_INTERVAL_MS=10000

# Comma-separated Upload-Post targets (Gate 5). If unset, defaults to youtube in assembly fallbacks.
# Set to none, skip, or 0 to skip Gate 5 entirely (full gates 0–4 E2E without burning YouTube daily upload quota).
# AUTO_PUBLISH_PLATFORMS=youtube
# AUTO_PUBLISH_PLATFORMS=none

# =============================================================================
# ATLASSIAN (JIRA / CONFLUENCE) — Doppler auraflux/prd only
# =============================================================================
# Do NOT put ATLASSIAN_API_TOKEN in local .env. Bootstrap with DOPPLER_TOKEN (see below).
#
#   bash scripts/doppler_run.sh <command>
#   bash scripts/session_close.sh
#   Cursor MCP → scripts/run_atlassian_mcp.sh
#
# In Doppler auraflux/prd:
#   ATLASSIAN_DOMAIN=aurafluxco.atlassian.net
#   ATLASSIAN_EMAIL=robert@auraflux.co
#   JIRA_PROJECT_KEY=CPD
#   CONFLUENCE_SPACE_KEY=CP
#
# DOPPLER bootstrap (local .env only):
DOPPLER_TOKEN=dp.st.prd.xxxx

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Topaz Labs (video upscaling - optional)
TOPAZLABS_API_KEY=your-topaz-labs-key-here

# Canva Connect API (thumbnail generation)
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret

# Financial Modeling Prep (market ticker data)
FMP_API_KEY=your-fmp-api-key-here

# =============================================================================
# VIDEO PROCESSING
# =============================================================================

# VectCut API (Python video editing service)
VECTCUT_API_URL=http://localhost:9001

# Short-form video settings
SHORT_FORM_LOGO_SIZE=80           # Logo size in pixels for 9:16 videos
SHORT_FORM_AUDIO_MIX=both         # both, source_only, or avatar_only

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Server ports
PORT=3000                         # Node.js API server
DASHBOARD_PORT=8765               # Static file server (dashboard)

# Custom FFmpeg paths (optional - auto-detected if not set)
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# CORS origins (comma-separated, optional)
# ALLOWED_ORIGINS=http://localhost:8765,http://localhost:3000

# =============================================================================
# BRAND SETTINGS
# =============================================================================

# Brand colors
BRAND_NAVY=#22304b
BRAND_GOLD=#c7af4f

# Logo settings
LONG_FORM_LOGO_SIZE=120           # Logo size for 16:9 videos
LONG_FORM_LOGO_OPACITY=0.85       # Logo opacity (0.0 to 1.0)

# =============================================================================
# DEVELOPMENT / DEBUG
# =============================================================================

# Uncomment for development
# NODE_ENV=development
# DEBUG=true
# LOG_LEVEL=debug

# Uncomment to skip certain QA gates during testing
# SKIP_GATE_1=false
# SKIP_GATE_2=false
# SKIP_GATE_3=false

# =============================================================================
# Queue & Caching (BullMQ + Redis)
# =============================================================================
REDIS_URL=redis://localhost:6379   # BullMQ + caching. Render Redis add-on URL in production.

# =============================================================================
# Job run timeline (logs/job_run_timeline.jsonl — see getJobSpec().observability)
# =============================================================================
# When the file exceeds JOB_TIMELINE_MAX_BYTES it is rotated to *.bak (default 50MB).
# JOB_TIMELINE_MAX_BYTES=52428800
# Caps for JSON written to the timeline only (in-process bus payloads are not truncated).
# JOB_TIMELINE_STRING_MAX=4000
# JOB_TIMELINE_ARRAY_MAX=16

# =============================================================================
# PATHS (override defaults when binaries are non-standard locations)
# =============================================================================
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# CWN_DB_PATH=data/cwn.db           # SQLite path override (default: data/cwn.db)

# =============================================================================
# SERVER / CORS / RUNTIME
# =============================================================================
NODE_ENV=development                  # development | production
LOG_LEVEL=info                        # debug | info | warn | error
ALLOWED_ORIGINS=http://localhost:3000 # Comma-separated CORS allowed origins
NR_PIPELINE_SERVICE=cwn-c0-local      # New Relic service name tag for pipeline events

# =============================================================================
# GEMINI MODEL OVERRIDES
# =============================================================================
# GEMINI_MODEL=gemini-2.5-pro-preview-05-06   # Default Gemini model
# GEMINI_SCRIPT_MODEL=gemini-2.5-pro-preview-05-06  # Model used for script gen
# GEMINI_GATE=gemini-2.5-flash                # Lighter model for gate QA checks

# =============================================================================
# HEYGEN SIMULATION / ADMIN
# =============================================================================
# HEYGEN_SIM_MODE=true              # Use simulated HeyGen responses (no credits used)
# HEYGEN_SIM_DURATION_SEC=10        # Simulated video duration
# HEYGEN_SIM_FONT=Arial             # Simulated video font
# HEYGEN_ADMIN_TOKEN=               # HeyGen admin token (folder management)
# HEYGEN_VERIFY_FOLDER=             # Folder ID to verify renders land in
HEYGEN_AVATAR_SHORT_NEWS_ID=        # Avatar ID for short-form news segments
HEYGEN_AVATAR_SHORT_NBA_ID=         # Avatar ID for short-form NBA segments
HEYGEN_AVATAR_SHORT_TWITCH_ID=      # Avatar ID for short-form Twitch segments

# =============================================================================
# NEWS SOURCE TUNING
# =============================================================================
# NEWS_AJ_MAX_CLIP_SEC=90           # Max clip length from Al Jazeera (seconds)
# NEWS_BBC_MAX_CLIP_SEC=60          # Max clip length from BBC
# NEWS_AJ_PINNED_URLS=              # Comma-separated AJ URLs to always include
# NEWS_RSS_URL=                     # Custom RSS feed URL for news source
# NEWS_US_PRIMARY_HUB_URL=          # Primary US news hub URL override
# NEWS_US_CANADA_HUB_URL=           # Canada news hub URL override
# SHORT_CLIP_WINDOW_MAX_SEC=30      # Max clip window for short-form assembly

# =============================================================================
# SOCIAL PUBLISH TOKENS
# =============================================================================
TIKTOK_ACCESS_TOKEN=                # TikTok publish token
INSTAGRAM_ACCESS_TOKEN=             # Instagram Business token
INSTAGRAM_ACCOUNT_ID=               # Instagram Business account ID
# AUTO_PUBLISH_PLATFORMS=youtube    # Comma-separated platforms to auto-publish (overrides config)

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
FINNHUB_API_KEY=                    # Finnhub stock/market data (NBA/sports jobs)
CANVA_ACCESS_TOKEN=                 # Canva API token for thumbnail generation
CAPCUT_URL=                         # CapCut export webhook URL (short-form)
SYNTH_ASSEMBLE_API_URL=             # Synthesis assembly URL (pre-built video jobs)

# =============================================================================
# ASSEMBLY / CHROME FLAGS
# =============================================================================
# ENABLE_NVENC=true                 # Use NVIDIA hardware encoding (requires CUDA)
# CWN_OVERLAY_BASELINE_PRESET=      # Chrome overlay CSS baseline preset name
# SKIP_DRIVE_UPLOAD=false           # Skip Google Drive upload step (local testing)
# GATE_TEST_MODE=false              # Run gates in test mode (skip external API calls)

# =============================================================================
# QA / AUTOMATION TUNING
# =============================================================================
# QA_CONFIRM_ON_GENERATE=true       # Auto-confirm jobs after script generation
# QA_MAX_INTERVENTION_ATTEMPTS=3    # Max times QA will attempt to fix a failing job
# QA_MAX_WORKER_SENDBACKS=2         # Max sendbacks before a gate escalates
# AUTOMATION_SELF_HEAL_MAX=3        # Max self-heal attempts per assembly
# SCAFFOLD_PERSISTENCE_STRICT=false # Strict scaffold persistence (fail if template missing)
# AI_MEMORY_TRACE_ENABLED=false     # Emit AI memory trace events to pipeline log

# Cloudflare R2 — publish path storage (CPD-887). Replaces Google Drive:
# assembled video + thumbnail upload to R2; Upload-Post fetches from the public URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_VIDEO_BUCKET=auraflux-video-output
R2_ASSETS_DOMAIN=
R2_BACKUP_BUCKET=

# TwelveLabs Pegasus QA (CPD-922) — Gate 4 for videos exceeding Gemini's 500MB cap.
# Analyzes by public URL (R2), supports videos up to 1 hour.
TWELVE_LABS_API_KEY=

# Direct YouTube publish (CPD-923) — OAuth client for the ClipzWorld channel.
# One-time connect: visit http://localhost:<PORT>/connect/youtube
# Tokens persist in data/youtube_tokens.json (gitignored).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Set true ONLY after thumbnail parity is verified — Upload-Post stays default until then.
YOUTUBE_DIRECT_PUBLISH=false

# Post-processing pass (CPD-925) — runs after Gate 3, before R2 upload.
# CAPTIONS_SHORTS:  Whisper-transcribed burned-in captions on short-form (default on; set false to disable)
# CAPTIONS_STYLE:   default | animated | burnin
# FINAL_LOUDNORM:   final-pass two-pass EBU R128 loudness on every video (default on; set false to disable)
CAPTIONS_SHORTS=true
CAPTIONS_STYLE=default
FINAL_LOUDNORM=true

# --- Live Grid (CPD-940) ---
# TWITCH_OAUTH_CLIENT_ID: localhost Twitch app for the /connect/twitch user
#                      OAuth flow (its registered redirect is
#                      http://localhost:3000/connect/twitch; the production
#                      TWITCH_CLIENT_ID app redirects to auraflux.co)
# TWITCH_OAUTH_CLIENT_SECRET: client secret of that app (must be a
#                      Confidential client). When set, /connect/twitch uses the
#                      authorization-code grant: one browser auth ever, then the
#                      server auto-refreshes the token forever (CPD-966).
#                      Unset = legacy implicit grant (~4h tokens, manual re-auth).
# TWITCH_FOLLOWS_USER: Twitch login whose followed channels become the default
#                      bench (CPD-953; default clipzworldnews). Requires the
#                      one-time user OAuth connect at /connect/twitch.
# LIVE_GRID_BENCH:     comma-separated fallback streamers — fallback when the
#                      followed-channels bench is unavailable; only seated when
#                      fewer than 4 A-roster streamers are live; evicted the
#                      moment a roster streamer comes online (CPD-951)
# LIVE_GRID_PRIVACY:   YouTube broadcast privacy for grid streams (CPD-977).
#                      Default 'public' — unlisted streams earn no public watch
#                      hours. Set 'unlisted' only for rehearsal/test runs.
# YOUTUBE_LIVE_PLAYLIST_ID:    playlist id for "ClipzWorld Live streams" (optional —
#                      auto-detected by title if unset)
# YOUTUBE_LIVE_PLAYLIST_TITLE: playlist title to search (default ClipzWorld Live streams)
# YOUTUBE_CHANNEL_NAME:        SEO copy channel name (default ClipzWorld News)
# YOUTUBE_CHANNEL_HASHTAG:     appended to live titles (default #ClipzWorldNews)
# LIVE_GRID_LIVE_THUMBNAIL: on | off — branded 1280×720 thumb on GO LIVE (default on)
# LIVE_GRID_MUSIC_GUARD: 'off' disables the music guard (CPD-979 — samples each
#                      live quadrant's audio every 15s, Gemini classifies music
#                      presence; on-air music → switch to a clean quadrant or
#                      mute the mix so grid VODs stop catching song claims).
# LIVE_GRID_RTSP_BASE: MediaMTX RTSP read base (default rtsp://localhost:8554)
# LIVE_GRID_SRT_BASE:  MediaMTX SRT publish base (default srt://localhost:8890)
# LIVE_GRID_TWITCH_QUALITY: streamlink quality ladder (default 1080p60,1080p,720p60,720p,best)
# LIVE_GRID_FPS:           master output frame rate (default 60)
# LIVE_GRID_BITRATE_K:     landscape video bitrate kbps (default 6800 — YouTube 1080p rec)
# LIVE_GRID_AUDIO_BITRATE_K: AAC bitrate kbps (default 192)
# LIVE_GRID_ENCODER:       videotoolbox (default) or libx264
# LIVE_GRID_FREEZE_FALLBACK_MS: RTSP dead after swap → master restart (default 15000)
# LIVE_GRID_SWAP_RESTART: on | off — debounced master restart on every swap (default off;
#                      ffmpeg RTSP cannot hot-reconnect; if tiles freeze after swaps set on)
# LIVE_GRID_DUAL_BROADCAST: on | off — legacy second YT listing + ffmpeg 9:16 leg (CPD-1005; default off, CPD-1029)
# LIVE_GRID_VERTICAL:       deprecated — use LIVE_GRID_DUAL_BROADCAST=on; auto/on still enables legacy dual
# LIVE_GRID_VERTICAL_OUTPUT: optional second 9:16 RTMP target (manual ingest; no auto YT broadcast)
# Mobile portrait default: single landscape RTMP + YouTube Studio "horizontal + vertical automatic"
# LIVE_GRID_MEMBER_ONLY_AUDIO: on | off — only channel members can !listen (default on)
# LIVE_GRID_SWAP_REQUIRES_LIKES: on | off — !swap needs a like milestone first (default on)
# LIVE_GRID_UDP_RELAY: on | off — RTSP→UDP per-quadrant relays; master reads UDP (default on, CPD-1006)
# LIVE_GRID_UDP_BASE_PORT: first UDP port for quad1 relay (default 5010, uses 5010–5013)
# LIVE_GRID_PROGRAM_MODE: auto | grid | news_desk | event_night — daypart programming (CPD-1017)
# LIVE_GRID_PROGRAM_CONFIG: path to programs JSON (default config/live_grid_programs.json)
# LIVE_GRID_EVENT_FILE: fallback produced file for event_night Q0 when no live feed found
# LIVE_GRID_EVENT_FEED_URL: force allowlisted live URL for event Q0 (YouTube/Twitch/Kick/Trovo/DLive/Rumble/CHZZK/Nimo)
# LIVE_GRID_FEED_SOURCES: config/live_grid_feed_sources.json — pins + queries per event type
# LIVE_GRID_ALT_PROBE_TIMEOUT_MS: streamlink probe timeout for alt platforms (default 12000)
# LIVE_GRID_OPERATOR_MODE: on | off — on = you control swaps; off = auto pilot (default on)
# LIVE_GRID_FEED_PICK_CACHE_MS: cache feed discovery (default 300000 = 5 min)
# LIVE_GRID_YT_FEED_DISCOVERY: on | off — YouTube live search for event feeds (uses API quota)
# LIVE_GRID_URL_QUALITY: streamlink quality for URL feeds (default best)
# LIVE_GRID_FEED_ALLOWLIST_ENFORCE: on | off — block non-allowlisted feed URLs (default on)
# LIVE_GRID_PROGRAM_TICK_MS: segment/mode recheck interval (default 60000)
# LIVE_GRID_FEEDER_RETRY_MS: file/channel feeder retry delay (default 5000)
# LIVE_GRID_MEMBER_SWAP_COOLDOWN_MS: per-member !swap cooldown (default 1800000 = 30 min)
# LIVE_GRID_LIKES_MILESTONE: off | N — announce in chat every N likes (default 50)
# LIVE_GRID_LIKES_POLL_MS:   like-count poll interval (default 300000 = 5 min)
# LIVE_GRID_BENCH=caseoh_,kaicenat,plaqueboymax
# LIVE_GRID_OUTPUT_MIDDLEWARE: on | off — compositor → local HLS → restreamer → YouTube (Render default on)
# LIVE_GRID_DELIVERY_HLS_STALE_MS: HLS segment age before delivery_qa flags hls_stale (default 8000)
# STREAM_DELIVERY_AUTO_HEAL: on | off — sidecar restarts restreamer on critical delivery signals (default on)
# STREAM_DELIVERY_HEAL_COOLDOWN_SEC: min seconds between auto-heal restreamer restarts (default 90)
# LIVE_SIDECAR_HEARTBEAT_MS: delivery QA + autotune poll interval (default 30000)

# --- ClipzWorld TV (CPD-956) — 24/7 loop of produced videos → Twitch ---
# TWITCH_STREAM_KEY: the channel's stream key (Twitch dashboard → Settings →
#                    Stream). Credential only — /live-tv/start activates the loop.
# TWITCH_STREAM_KEY=live_xxxxxxxxx

# --- Stream scheduler (CPD-975/976) — daily programming windows, ET ---
# STREAM_SCHEDULER=off disables auto start/stop entirely (default: on)
# LIVE_BROADCAST_SIDECAR=on          Route /live-tv + /live-grid ffmpeg to sidecar (default on)
# LIVE_SIDECAR_URL=http://127.0.0.1:3001   Sidecar HTTP — survives pm2 restart auraflux
# LIVE_SIDECAR_PORT=3001             Port for pm2 process broadcast-sidecar
# LIVE_SIDECAR_BIND=127.0.0.1          Use 0.0.0.0 on Render broadcast worker (CPD-1040)
# Render: LIVE_SIDECAR_URL=http://auraflux-broadcast-staging:10000  (internal — on auraflux-api-staging)
# LIVE_TV_WINDOW=15:00-18:00     Twitch loop block (default 12pm–6pm ET; CPD-995 runs a denser 3h block); "off" excludes the stream from scheduling (CPD-994)
# CALENDAR_LIVE_SYNC=off          Keep off until news desk has day-fresh VODs (see NEWS_DESK_MAX_AGE_HOURS).
#                                 When on, hot-switches grid dayparts without stopping RTMP.
# NEWS_DESK_MAX_AGE_HOURS=24      news_desk daypart + live sync require produced news VOD newer than this.
# CALENDAR_OWNER_PIN=1010         Only Rob — owner unlock + calendar overrides (Content Calendar)
# PRODUCTION_CRON=off             CPD-1053: autonomous calendar production (default off on Render; on locally)
# PRODUCTION_CRON_CUSTOMER_ID=c0  Brand/customer for cron-fired /generate-clip-comp jobs
# REPURPOSE_SHORTS=on            CPD-998: published longform auto-spawns a vertical sibling short (clip short / news-short / nba-short). Default off.
# LIVE_GRID_WINDOW=18:00-03:00   YouTube Live Grid window (default 6pm–3am ET)
# LIVE_GRID_WINDOW=00:00-24:00   24h measurement run — optimize schedule from analytics
# LIVE_GRID_PLATFORM_BENCH=on    merge global Twitch top-live into bench (default on)
# LIVE_GRID_AVATAR_PIP=auto      Bobby G reaction loop bottom-left on grid (auto|off|path via LIVE_GRID_AVATAR_OVERLAY)
# LIVE_GRID_EVENT_CALENDAR=config/live_grid_event_calendar.json
# LIVE_GRID_ALLOWLIST=config/live_grid_allowlist.json
# LIVE_GRID_ALLOWLIST_ENFORCE=on block non-allowlisted event ids (future)
# Broadcast dashboard (CPD-1026–1028): GET /broadcast/ops, POST /broadcast/24h-arm, GET /live-grid/files
# =============================================================================
