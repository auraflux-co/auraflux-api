#!/bin/sh
# FFmpeg via Docker container (linuxserver/ffmpeg - native ARM64, FFmpeg 8.x)
# Drop-in replacement for local ffmpeg binary.
# Mounts the project and tmp directories so all absolute paths work.

exec docker run --rm \
  --platform linux/arm64 \
  -v /Users/robertgregory/cwn-production:/Users/robertgregory/cwn-production \
  -v /private/tmp:/private/tmp \
  linuxserver/ffmpeg:latest \
  "$@"
