# AuraFlux App — environment variables
# Copy to .env.local and fill in values

# Better Auth (required)
DATABASE_URL=postgresql://...
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
AUTH_JWT_SECRET=replace-with-same-or-separate-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
AUTH_PROVIDER=better-auth

# Optional: comma-separated emails that get superadmin on first profile create
AURAFLUX_SUPERADMIN_EMAILS=support@auraflux.co,robert@auraflux.co

# Legacy Clerk (only if AUTH_PROVIDER=clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# AuraFlux API backend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3000
AURAFLUX_API_SECRET=
