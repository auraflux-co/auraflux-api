# AuraFlux App — environment variables
# Copy to .env.local and fill in values

# Better Auth (required)
DATABASE_URL=postgresql://...
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
AUTH_JWT_SECRET=replace-with-same-or-separate-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
AUTH_PROVIDER=better-auth

# Google OAuth (Continue with Google) — set on Vercel for app.auraflux.co
# Authorized redirect URI (basePath=/api/id):
#   https://app.auraflux.co/api/id/callback/google
#   http://localhost:3001/api/id/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: comma-separated emails that get superadmin on login
AURAFLUX_SUPERADMIN_EMAILS=support@auraflux.co,robert@auraflux.co,robert@businessrocket.ai

# Legacy Clerk (only if AUTH_PROVIDER=clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# AuraFlux API backend (auth emails: password reset + OTP go through API SMTP)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3000
# Must match Render/Doppler AURAFLUX_API_SECRET — used for POST /internal/auth-email
AURAFLUX_API_SECRET=
