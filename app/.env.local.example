# AuraFlux App — environment variables
# Copy to .env.local and fill in values

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# AuraFlux API backend
NEXT_PUBLIC_API_URL=http://localhost:3000
# Base URL for all client-side API fetches (checkout, marketing editor, etc.)
# Production: https://auraflux-api.onrender.com
NEXT_PUBLIC_API_BASE=http://localhost:3000
AURAFLUX_API_SECRET=

# --- AUTO-SYNCED frontend ---
# NEXT_PUBLIC_SMTP_CONFIGURED=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPPORT_SMS_NUMBER=
