Example docker-compose.yml Structure 
yaml
version: '3.8'
services:
  web:
    build: .
    ports:
      - "3000:3000"
    depends_on:
      - redis
  poller:
    build: .
    command: npm run poller
    depends_on:
      - redis
  redis:
    image: "redis:alpine"
    volumes:
      - redis_data:/data
volumes:
  redis_data:
