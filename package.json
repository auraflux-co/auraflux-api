{
  "name": "cwn-production",
  "version": "1.0.0",
  "description": "ClipzWorld News - AI-powered news and reaction show production system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dashboard": "python3 -m http.server 8765",
    "vectcut": "cd VectCutAPI && ./venv-capcut/bin/python3 capcut_server.py",
    "test": "node test/ffmpeg_utils.test.js",
    "test:all": "node test/run_tests.js",
    "cleanup": "curl -X POST http://localhost:3000/cleanup -H 'Content-Type: application/json' -d '{\"keepCount\":2,\"cleanTmp\":true,\"cleanQaLogs\":false}'",
    "disk-usage": "curl http://localhost:3000/disk-usage",
    "auth-drive": "node cwn-auth.js",
    "jira-ping": "node scripts/jira_ping.js",
    "qa:install": "npx playwright install chromium",
    "qa:record": "node qa/record_session.js",
    "qa:clean": "rm -rf output/qa_sessions/*",
    "qa:baseline": "node qa/visual_regression.js --update",
    "qa:regression": "node qa/visual_regression.js",
    "benchmark": "node qa/benchmark.js",
    "benchmark:concurrent": "node qa/benchmark.js --concurrent"
  },
  "keywords": [
    "ai",
    "video-production",
    "news",
    "twitch",
    "nba",
    "heygen",
    "claude",
    "gemini",
    "ffmpeg",
    "automation"
  ],
  "author": "ClipzWorld News",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.14.0",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.74.1",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "fluent-ffmpeg": "^2.1.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "multer": "^1.4.5-lts.1",
    "newrelic": "^13.19.1",
    "node-cron": "^3.0.3",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "puppeteer": "^24.40.0",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.32.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "nodemon": "^3.0.0",
    "playwright": "^1.59.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clipzworldnews/cwn-production.git"
  },
  "bugs": {
    "url": "https://github.com/clipzworldnews/cwn-production/issues"
  },
  "homepage": "https://github.com/clipzworldnews/cwn-production#readme"
}
