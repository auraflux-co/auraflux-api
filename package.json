{
  "name": "cwn-production-server",
  "version": "1.0.0",
  "description": "CWN Production Server — FFmpeg assembly + Canva import proxy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/ffmpeg_utils.test.js",
    "qa:install": "npx playwright install chromium",
    "qa:record": "node qa/record_session.js",
    "qa:clean": "rm -rf output/qa_sessions/*",
    "qa:baseline": "node qa/visual_regression.js --update",
    "qa:regression": "node qa/visual_regression.js",
    "benchmark": "node qa/benchmark.js",
    "benchmark:concurrent": "node qa/benchmark.js --concurrent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.14.0",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "puppeteer": "^24.40.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "playwright": "^1.59.1"
  }
}
