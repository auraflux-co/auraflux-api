{
  "name": "auraflux-api",
  "version": "1.0.642",
  "description": "AuraFlux — AI-powered video content production platform",
  "main": "server.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.js --env production",
    "start:cluster": "pm2 start ecosystem.config.js -i max --env production",
    "stop": "pm2 stop auraflux",
    "restart": "pm2 reload auraflux",
    "logs": "pm2 logs auraflux",
    "status": "pm2 status",
    "dev": "pm2 start ecosystem.config.js --env development",
    "dashboard": "python3 -m http.server 8765",
    "vectcut": "cd VectCutAPI && ./venv-capcut/bin/python3 capcut_server.py",
    "db:backfill-canonical": "node scripts/backfill_canonical_job_ids.cjs",
    "db:backfill-canonical:dry": "node scripts/backfill_canonical_job_ids.cjs --dry-run",
    "test": "jest",
    "test:all": "node test/run_tests.js",
    "test:ci": "jest --runInBand --ci",
    "cleanup": "curl -X POST http://localhost:3000/cleanup -H 'Content-Type: application/json' -d '{\"keepCount\":2,\"cleanTmp\":true,\"cleanQaLogs\":false}'",
    "disk-usage": "curl http://localhost:3000/disk-usage",
    "auth-drive": "node cwn-auth.js",
    "jira-ping": "node scripts/jira_ping.js",
    "nr-health": "node scripts/newrelic_health.js",
    "qa:install": "npx playwright install chromium",
    "qa:record": "node qa/record_session.js",
    "qa:clean": "rm -rf output/qa_sessions/*",
    "qa:baseline": "node qa/visual_regression.js --update",
    "qa:regression": "node qa/visual_regression.js",
    "benchmark": "node qa/benchmark.js",
    "benchmark:concurrent": "node qa/benchmark.js --concurrent",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"**/*.{js,json,md,html,css,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,json,md,html,css,yml,yaml}\" --ignore-path .prettierignore",
    "load-test:health": "node scripts/load_test_autocannon.js",
    "smoke:deploy": "node scripts/smoke_deploy.cjs",
    "phase-a:batch": "node scripts/phase_a_batch.cjs",
    "phase-a:batch:mini": "PHASE_A_JOBS=nba_lf,news_short PHASE_A_WATCH_EXIT_ON_STABLE=1 PHASE_A_WATCH_STABLE_MS=180000 node scripts/phase_a_batch.cjs",
    "phase-a:watch": "node scripts/phase_a_gate_watch.cjs",
    "gate:contracts:check": "node scripts/gate_contract_consistency_check.cjs",
    "phase-a:batch:sim": "HEYGEN_SIM_MODE=true node scripts/phase_a_batch.cjs",
    "job-monitor": "node scripts/job_monitor_daemon.cjs",
    "heygen:manual-queue": "node scripts/heygen_manual_queue.cjs",
    "heygen:manual-queue:resume": "node scripts/heygen_manual_queue.cjs --resume",
    "manual:ingest": "node scripts/manual_ingest.cjs",
    "manual:ingest:latest": "node scripts/manual_ingest.cjs --latest",
    "prompt-replay:offline": "node scripts/prompt_replay_offline.cjs",
    "heygen:delete-all": "node scripts/heygen_delete_all.cjs --confirm"
  },
  "keywords": [
    "ai",
    "video-production",
    "news",
    "twitch",
    "nba",
    "heygen",
    "claude",
    "gemini",
    "ffmpeg",
    "automation"
  ],
  "author": "AuraFlux",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@clerk/express": "^2.1.10",
    "@elevenlabs/elevenlabs-js": "^2.45.0",
    "axios": "^1.15.2",
    "bullmq": "^5.77.1",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "newrelic": "^13.19.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.40.0",
    "sharp": "^0.34.5",
    "stripe": "^22.1.0",
    "svix": "^1.93.0",
    "telnyx": "^6.66.2",
    "twilio": "^6.0.0"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "eslint": "^10.2.1",
    "jest": "^30.3.0",
    "playwright": "^1.60.0",
    "prettier": "^3.5.3",
    "supertest": "^7.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/auraflux-co/auraflux-api.git"
  },
  "bugs": {
    "url": "https://github.com/auraflux-co/auraflux-api/issues"
  },
  "homepage": "https://github.com/auraflux-co/auraflux-api#readme",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60
      }
    }
  },
  "overrides": {
    "uuid": ">=14.0.0"
  }
}
