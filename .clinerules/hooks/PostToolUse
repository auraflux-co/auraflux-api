#!/bin/bash
# PostToolUse hook — cwn-production
# Fires after every Cline tool execution.
# Handles BOTH nested schema (postToolUse.tool) AND flat schema (tool at root)
# Fixes exit-code-1 retry loop: grep/find with no results exits 1, Cline retries endlessly.

INPUT=$(cat)

# Try nested schema first (postToolUse.tool), fall back to flat schema (tool)
TOOL=$(echo "$INPUT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
val = d.get('postToolUse',{}).get('tool','') or d.get('tool','')
print(val)
" 2>/dev/null)

SUCCESS=$(echo "$INPUT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
val = d.get('postToolUse',{}).get('success','') or d.get('success','')
print(val)
" 2>/dev/null)

COMMAND=$(echo "$INPUT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
nested = d.get('postToolUse',{}).get('parameters',{})
flat = d.get('parameters',{})
p = nested if nested else flat
print(p.get('command', p.get('cmd', '')))
" 2>/dev/null)

FILEPATH=$(echo "$INPUT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
nested = d.get('postToolUse',{}).get('parameters',{})
flat = d.get('parameters',{})
p = nested if nested else flat
print(p.get('path', p.get('file_path', '')))
" 2>/dev/null)

# ── Fix 1: grep/find/rg exit code 1 = no results, not a failure ──────────────
if [[ "$SUCCESS" == "False" || "$SUCCESS" == "false" ]]; then
  if echo "$COMMAND" | grep -qE "^\s*(grep|rg|find|ag|ls)\b"; then
    cat <<EOF
{"cancel":false,"contextModification":"Note: The search command returned no matches (exit code 1 = no results found, not an error). This is expected — do NOT retry. Append || true to all search commands to prevent this. Continue with the task.","errorMessage":""}
EOF
    exit 0
  fi
fi

# ── Fix 2: syntax-check any .js file Cline just wrote ────────────────────────
if [[ "$TOOL" == "write_to_file" || "$TOOL" == "replace_in_file" ]]; then
  if [[ "$FILEPATH" == *.js ]]; then
    SYNTAX=$(node -c "$FILEPATH" 2>&1)
    if [ $? -ne 0 ]; then
      MSG="Syntax error detected in ${FILEPATH}: ${SYNTAX}. Fix the syntax error before continuing."
      cat <<EOF
{"cancel":false,"contextModification":"${MSG}","errorMessage":""}
EOF
      exit 0
    fi
  fi
fi

# Default: pass through
cat <<EOF
{"cancel":false,"contextModification":"","errorMessage":""}
EOF
exit 0
