{
  "name": "render-broadcast-nightly",
  "version": "2026-06-20",
  "description": "Render Pro 4-quad grid — 1080p direct RTMP, localhost-parity encode for stability pilot.",
  "env": {
    "LIVE_GRID_ENCODER": "libx264",
    "LIVE_GRID_X264_PRESET": "veryfast",
    "LIVE_GRID_RELAY_TRANSCODE": "off",
    "LIVE_GRID_UDP_RELAY": "on",
    "LIVE_GRID_TWITCH_QUALITY": "720p60,720p,best",
    "LIVE_GRID_OUTPUT_MIDDLEWARE": "off",
    "LIVE_GRID_STAGED_SWAP": "on",
    "LIVE_GRID_RESTREAMER_HOLD": "on",
    "LIVE_GRID_SWAP_DEBOUNCE_MS": "8000",
    "LIVE_GRID_SWAP_STABLE_MS": "3000",
    "LIVE_GRID_LOCAL_HLS": "on",
    "LIVE_GRID_FPS": "30",
    "LIVE_GRID_OUTPUT_W": "1920",
    "LIVE_GRID_OUTPUT_H": "1080",
    "LIVE_GRID_BITRATE_K": "6000",
    "LIVE_GRID_AUTOTUNE": "off",
    "LIVE_GRID_MUSIC_GUARD": "off",
    "LIVE_GRID_AUDIO_BITRATE_K": "192",
    "LIVE_GRID_AUDIO_DIRECT": "on",
    "LIVE_GRID_AUDIO_COPY": "off",
    "LIVE_GRID_AUDIO_HZ": "48000",
    "LIVE_GRID_HLS_TIME": "2",
    "LIVE_GRID_HLS_LIST_SIZE": "24",
    "LIVE_GRID_HLS_DELETE_SEGMENTS": "off",
    "LIVE_SIDECAR_BIND": "0.0.0.0",
    "STREAM_DELIVERY_AUTO_HEAL": "on",
    "LIVE_SIDECAR_HEARTBEAT_MS": "15000",
    "STREAM_DELIVERY_HEAL_COOLDOWN_SEC": "45",
    "STREAM_DELIVERY_COMPOSITOR_HEAL_COOLDOWN_SEC": "90",
    "LIVE_GRID_POST_SWAP_DELIVERY_CHECK_MS": "12000",
    "LIVE_GRID_DELIVERY_HLS_STALE_MS": "8000"
  },
  "notes": [
    "1080p@6000k veryfast — localhost parity (c0 uses 6800k VideoToolbox on Mac)",
    "Direct RTMP (middleware off) — compositor → YouTube, no HLS restreamer hop",
    "AUTOTUNE off during pilot — no surprise master restarts mid-stream"
  ]
}
