              "news": "#c7af4f",
              "clips": "#6441A5",
              "sports": "#1CE8FF"
            }
          }
        },
        "voice": {
          "lockedIntro": {
            "news": "I'm Bobby G, and this is Because the Light was on. I'm told this is the news. A recent study shows that people who watch news programs are 40% more likely to be aware that a news program is currently happening. ... [Pause] ... Here are some things that occurred while we weren't looking.",
            "clips": "Welcome to Twitch Soup. I'm your host Bobby G, and for the next five minutes, I'll be your guide through the digital world that is livestreaming.",
            "sports": "What's up, ClipzWorld! Grab your shades, because we're heading to the Other Side of the Pillow. I'm Bobby G, and we're breaking down the highlights that weren't just good—they were cold."
          },
          "lockedOutro": "That's all the time we have before the light bill is due. I'm Bobby G for ClipzWorld News. Keep your clips short and your takes shorter. Goodnight and good luck.",
          "showName": {
            "news": "BECAUSE THE LIGHT WAS ON",
            "clips": "TWITCH SOUP",
            "sports": "OTHER SIDE OF THE PILLOW"
          },
          "categoryLabel": {
            "news": "WORLD NEWS",
            "clips": "ON STREAM",
            "sports": "NBA GAME"
          }
        },
        "audio": {
          "mixMode": "both",
          "avatarTrack": true,
          "sourceTrack": true
        },
        "resolution": {
          "width": 1920,
          "height": 1080
        },
        "avatarId": "842f20b75ce242aea397f5030aa018aa",
        "voiceId": "2e598f1a6022448cb6710e5d44665325",
        "speakSpeed": 0.85
      },
      "qaThresholds": {
        "gate0": {
          "minDurationSeconds": 10
        },
        "gate1": {
          "pass": 90,
          "manualReview": 55
        },
        "gate2": {
          "pass": 85,
          "manualReview": 65
        },
        "gate3a": {
          "pass": 70,
          "manualReview": 60
        },
        "gate4": {
          "pass": 70
        }
      },
      "voice": {
        "style": "jon-stewart-norm-macdonald-space-ghost",
        "prohibitedWords": [
          "incredible",
          "amazing",
          "crazy",
          "wild"
        ],
        "outroLine": "Goodnight and good luck.",
        "speakerName": "Bobby G"
