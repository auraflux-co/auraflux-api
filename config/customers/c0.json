          "contentTypeOverrides": {
            "news": {
              "name": "BECAUSE THE LIGHT WAS ON",
              "colors": { "primary": "#22304b", "accent": "#c7af4f", "active": "#C0392B" },
              "flag": {
                "topGapBelowTopBar": 0,
