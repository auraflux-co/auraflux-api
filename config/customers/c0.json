      "contentTypes": [
        "news",
        "clips",
        "sports",
        "twitch",
        "nba"
      ],
      "sceneFormulas": {
        "news": "1 + (items * 4) + 1",
        "clips": "1 + (items * 7) + 1",
        "sports": "1 + (items * 4) + 1"
      },
      "maxItems": {
        "news": 5,
        "clips": 10,
        "sports": 5
      },
      "providers": {
        "fetch": "site_scrape",
        "script": "gemini",
        "avatar": "heygen",
        "assembly": "internal",
        "upload": "upload-post"
      },
      "designDefaults": {
        "chrome": {
          "name": "BECAUSE THE LIGHT WAS ON",
          "baselinePreset": "0415",

          "colors": {
            "primary":    "#22304b",
            "accent":     "#c7af4f",
            "active":     "#C0392B",
            "text":       "#ffffff",
            "background": "#0d1424"
          },

