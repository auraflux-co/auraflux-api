            "width": 620,
            "height": 88,
            "borderWidth": 4,
            "maxTitleChars": 50,
            "categoryLabel": {
              "news":   "WORLD NEWS",
              "clips":  "ON STREAM",
              "sports": "NBA GAME"
            }
          },

          "sidebar": {
            "top": 120,
