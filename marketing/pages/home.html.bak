<style>
#af-chat-btn{position:fixed;bottom:24px;right:24px;width:52px;height:52px;border-radius:50%;background:#7C3AED;border:none;cursor:pointer;box-shadow:0 4px 16px rgba(124,58,237,.45);display:flex;align-items:center;justify-content:center;z-index:99999;transition:transform .15s}
#af-chat-btn:hover{transform:scale(1.08)}
#af-chat-btn svg{width:24px;height:24px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#af-chat-panel{position:fixed;bottom:88px;right:24px;width:340px;max-width:calc(100vw - 32px);height:480px;background:#0f0f11;border:1px solid rgba(255,255,255,.1);border-radius:16px;box-shadow:0 16px 48px rgba(0,0,0,.6);display:flex;flex-direction:column;z-index:99998;overflow:hidden;transition:opacity .2s,transform .2s;opacity:0;transform:translateY(12px);pointer-events:none}
#af-chat-panel.open{opacity:1;transform:translateY(0);pointer-events:all}
#af-chat-header{padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:10px}
#af-chat-header .dot{width:8px;height:8px;border-radius:50%;background:#22c55e}
#af-chat-header span{color:#fff;font-size:14px;font-weight:600;flex:1}
#af-chat-close{background:none;border:none;color:rgba(255,255,255,.5);cursor:pointer;font-size:18px;line-height:1;padding:0}
#af-chat-msgs{flex:1;overflow-y:auto;padding:14px 16px;display:flex;flex-direction:column;gap:10px;scroll-behavior:smooth}
.af-msg{max-width:88%;padding:10px 13px;border-radius:12px;font-size:13.5px;line-height:1.5;word-break:break-word}
.af-msg.bot{background:rgba(255,255,255,.07);color:#e2e8f0;align-self:flex-start;border-bottom-left-radius:4px}
.af-msg.user{background:#7C3AED;color:#fff;align-self:flex-end;border-bottom-right-radius:4px}
.af-msg.typing{color:rgba(255,255,255,.4);font-style:italic}
#af-chat-escalate{padding:10px 14px;border-top:1px solid rgba(255,255,255,.08);display:none;flex-direction:column;gap:8px}
#af-chat-escalate input{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:#fff;border-radius:8px;padding:8px 10px;font-size:13px;outline:none;width:100%;box-sizing:border-box}
#af-chat-escalate input::placeholder{color:rgba(255,255,255,.35)}
#af-chat-escalate button{background:#7C3AED;color:#fff;border:none;border-radius:8px;padding:9px;font-size:13px;font-weight:600;cursor:pointer;width:100%}
#af-chat-form{padding:10px 12px;border-top:1px solid rgba(255,255,255,.08);display:flex;gap:8px}
#af-chat-input{flex:1;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:#fff;border-radius:8px;padding:9px 11px;font-size:13px;outline:none;resize:none;height:38px;line-height:1.4}
#af-chat-input::placeholder{color:rgba(255,255,255,.35)}
#af-chat-send{background:#7C3AED;border:none;color:#fff;border-radius:8px;padding:0 14px;cursor:pointer;font-size:16px;font-weight:700}
#af-chat-send:disabled{opacity:.45;cursor:not-allowed}
</style>
<button id="af-chat-btn" aria-label="Chat with AuraFlux">
  <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
</button>
<div id="af-chat-panel" role="dialog" aria-label="AuraFlux pre-sales chat">
  <div id="af-chat-header">
    <div class="dot"></div>
    <span>Ask AuraFlux</span>
    <button id="af-chat-close" aria-label="Close chat">&times;</button>
  </div>
  <div id="af-chat-msgs"></div>
  <div id="af-chat-escalate">
    <input id="af-esc-name" placeholder="Your name" type="text"/>
    <input id="af-esc-email" placeholder="Your email" type="email"/>
    <button id="af-esc-send">Send to our team</button>
  </div>
  <form id="af-chat-form" autocomplete="off">
    <textarea id="af-chat-input" placeholder="Ask about plans, features, pricing…" rows="1"></textarea>
    <button id="af-chat-send" type="submit">&#10148;</button>
  </form>
</div>
<script>
(function(){
  var API_CHAT    = 'https://app.auraflux.co/api/public/chat';
  var API_CONTACT = 'https://app.auraflux.co/api/public/contact';
  var panel  = document.getElementById('af-chat-panel');
  var btn    = document.getElementById('af-chat-btn');
  var msgs   = document.getElementById('af-chat-msgs');
  var form   = document.getElementById('af-chat-form');
  var input  = document.getElementById('af-chat-input');
  var send   = document.getElementById('af-chat-send');
  var escDiv = document.getElementById('af-chat-escalate');
  var history = [];
  var msgCount = 0;

  function addMsg(text, role) {
    var d = document.createElement('div');
    d.className = 'af-msg ' + role;
    d.textContent = text;
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
    return d;
  }

  function addTyping() {
    return addMsg('Thinking…', 'bot typing');
  }

  // Greeting
  addMsg('Hi! I’m the AuraFlux assistant. Ask me anything about plans, features, or pricing.', 'bot');

  btn.onclick = function() {
    panel.classList.toggle('open');
    if (panel.classList.contains('open')) setTimeout(function(){ input.focus(); }, 150);
  };
  document.getElementById('af-chat-close').onclick = function() {
    panel.classList.remove('open');
  };

  input.onkeydown = function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.dispatchEvent(new Event('submit')); }
  };

  form.onsubmit = function(e) {
    e.preventDefault();
    var text = input.value.trim();
    if (!text || send.disabled) return;
    input.value = '';
    addMsg(text, 'user');
    msgCount++;

    // Check for human escalation intent
    if (/human|talk to|speak to|person|team|sales|someone/i.test(text)) {
      addMsg('Of course! Drop your name and email below and we’ll reach out shortly.', 'bot');
      escDiv.style.display = 'flex';
      form.style.display = 'none';
      return;
    }

    send.disabled = true;
    var typing = addTyping();
    history.push({ role: 'user', content: text });

    fetch(API_CHAT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text, history: history.slice(-6) })
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      typing.remove();
      var reply = data.reply || 'Something went wrong. Email support@auraflux.co.';
      addMsg(reply, 'bot');
      history.push({ role: 'assistant', content: reply });
      // Offer human after 3+ exchanges
      if (msgCount >= 3) {
        var hint = document.createElement('div');
        hint.className = 'af-msg bot';
        hint.innerHTML = 'Want to talk to a person? <a href="#" style="color:#a78bfa" id="af-human-link">Connect me with the team</a>';
        msgs.appendChild(hint);
        msgs.scrollTop = msgs.scrollHeight;
        var hl = document.getElementById('af-human-link');
        if (hl) hl.onclick = function(ev) {
          ev.preventDefault();
          escDiv.style.display = 'flex';
          form.style.display = 'none';
        };
        msgCount = 0;
      }
    })
    .catch(function() {
      typing.remove();
      addMsg('Something went wrong. Please email support@auraflux.co.', 'bot');
    })
    .finally(function() { send.disabled = false; });
  };

  document.getElementById('af-esc-send').onclick = function() {
    var name  = document.getElementById('af-esc-name').value.trim();
    var email = document.getElementById('af-esc-email').value.trim();
    if (!name || !email) return;
    // Collect last user message as context
    var lastMsg = history.filter(function(m){ return m.role==='user'; }).slice(-1)[0];
    fetch(API_CONTACT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, email: email, message: lastMsg ? lastMsg.content : 'Pre-sales inquiry from marketing site chat.' })
    });
    escDiv.style.display = 'none';
    addMsg('Got it, ' + name + '! We’ll email you at ' + email + ' shortly.', 'bot');
  };
})();
</script></body>
</html>
