{
  "version": 2,
  "buildCommand": "python3 scripts/build-static.py",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/plans", "destination": "/pricing", "permanent": true },
    { "source": "/about", "destination": "/our-story", "permanent": true },
    { "source": "/system", "destination": "/features", "permanent": true },
    { "source": "/our-system", "destination": "/features", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/process", "destination": "/how-it-works", "permanent": true },
    { "source": "/blog/twitch-clip-to-published-video", "destination": "/blog/peaks-to-short", "permanent": false },
    { "source": "/sign-in", "destination": "https://app.auraflux.co/sign-in", "permanent": false },
    { "source": "/sign-up", "destination": "https://app.auraflux.co/sign-in", "permanent": false },
    { "source": "/signup", "destination": "https://app.auraflux.co/sign-in", "permanent": false },
    { "source": "/login", "destination": "https://app.auraflux.co/login", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
